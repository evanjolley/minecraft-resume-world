node_modules
dist
.DS_Store
.claude/

# Generated by scripts/build-textures.mjs.
# Untracked on purpose: `npm run textures:vanilla` writes Mojang assets here,
# which must not be committed to a public repo.
public/textures/
public/ui/
public/skins/

# Generated by scripts/build-sounds.mjs. Mojang audio, same rules as the
# textures above: fine locally, never committed.
public/sounds/

# Wrangler's local state: build output, cached account id, dev-mode storage.
# Regenerated on demand and machine-specific.
.wrangler/

# Local secrets for `wrangler dev`. Nothing needs it yet -- the Worker has no
# script and therefore no bindings -- but it is the one file in this workflow
# that must never be committed, and the time to ignore it is before it exists.
.dev.vars
.dev.vars.*

# Playwright's failure artifacts: traces and error contexts for the last run.
# Regenerated every run, useless once it passes.
test-results/

# Generated by scripts/build-terrain.mjs. A patch of real Minecraft terrain.
#
# Untracked for a reason this repo has NOT settled, unlike the textures above.
# Mojang's art is plainly theirs; this is the OUTPUT of their world generator,
# which is a different question. docs/DEPLOYMENT.md carries it as an open
# question at the deploy gate. Conservative default until someone answers it.
public/terrain/

# Generated by scripts/terrain/. Holds Mojang's server jar and the worlds it
# generates -- hundreds of megabytes of region files, regenerable from the
# seed in the manifest. Same rule as the textures above: fine locally, never
# committed.
.mcgen/

# The system prompt, built from corpus/ by `npm run prompt` at deploy time.
# Same rule as corpus/ itself and for the same reason: it IS corpus content,
# rearranged. See the header of scripts/build-prompt.mjs.
worker/prompt.generated.js

# Evan's own answers for the AI Evan corpus -- name, hometown, career detail,
# and things explicitly marked private. THIS REPO IS PUBLIC. The canonical copy
# lives in the artifact database behind the quiz; this is a local backup and
# must never be committed. See corpus/README.md.
corpus/
