{
  "name": "world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "textures": "node scripts/build-textures.mjs --source=ce",
    "textures:vanilla": "node scripts/build-textures.mjs --source=vanilla",
    "sounds": "node scripts/build-sounds.mjs",
    "postinstall": "node scripts/build-textures.mjs --ensure",
    "test": "playwright test -c test/playwright.config.js",
    "build:deploy": "rm -rf dist && npm run textures && vite build && rm -rf dist/sounds && cp deploy/_headers deploy/.assetsignore dist/",
    "deploy": "npm run build:deploy && npx --yes wrangler@4 deploy",
    "deploy:dry-run": "npm run build:deploy && npx --yes wrangler@4 deploy --dry-run"
  },
  "dependencies": {
    "@babylonjs/core": "^6.49.0",
    "noa-engine": "^0.33.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "sharp": "^0.35.4",
    "vite": "^8.2.2"
  }
}
