{
  "name": "world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "textures": "node scripts/build-textures.mjs",
    "textures:ce": "node scripts/build-textures.mjs --source=ce",
    "textures:vanilla": "node scripts/build-textures.mjs --source=vanilla",
    "textures:no-cape": "node scripts/build-textures.mjs --no-cape",
    "sounds": "node scripts/build-sounds.mjs",
    "sounds:free": "node scripts/build-sounds.mjs --source=free",
    "sounds:vanilla": "node scripts/build-sounds.mjs --source=vanilla",
    "terrain": "node scripts/build-terrain.mjs",
    "terrain:seeds": "node scripts/terrain/run-generate.mjs",
    "terrain:scan": "node scripts/terrain/run-scan.mjs",
    "terrain:blocks": "node scripts/terrain/run-blocks.mjs",
    "terrain:verify": "node scripts/terrain/verify.mjs",
    "terrain:nether:gen": "node -e \"import('./scripts/terrain/generate.mjs').then(m=>m.generateSeed(process.env.SEED??'12345',96,{dimension:'nether'}))\"",
    "terrain:nether": "node scripts/terrain/nether.mjs",
    "terrain:nether:verify": "node scripts/terrain/verify.mjs nether",
    "terrain:mountains:gen": "node -e \"import('./scripts/terrain/generate.mjs').then(m=>m.generateSeed('434533485056755',256))\"",
    "terrain:mountains": "SEED=434533485056755 PATCH_X=-112 PATCH_Z=0 PATCH_SIZE=256 PATCH_NAME=mountains SPAWN_AT=-32,116 node scripts/build-terrain.mjs",
    "terrain:mountains:verify": "node scripts/terrain/verify.mjs mountains",
    "postinstall": "node scripts/build-textures.mjs --ensure && node scripts/build-sounds.mjs --ensure",
    "prompt": "node scripts/build-prompt.mjs",
    "prompt:check": "node scripts/build-prompt.mjs --check",
    "prompt:ci": "node scripts/build-prompt.mjs --allow-stub",
    "test": "playwright test -c test/playwright.config.js",
    "smoke": "playwright test -c test/playwright.config.js test/01-world.spec.js test/43-browsers.spec.js --project=chromium",
    "build:deploy": "rm -rf dist && node scripts/build-textures.mjs --source=ce --no-cape && npm run sounds:free && vite build && rm -rf dist/terrain && cp deploy/_headers deploy/.assetsignore dist/ && node scripts/check-deploy-assets.mjs",
    "deploy": "npm run prompt && npm run build:deploy && npx --yes wrangler@4 deploy",
    "deploy:dry-run": "npm run prompt && npm run build:deploy && npx --yes wrangler@4 deploy --dry-run"
  },
  "dependencies": {
    "@babylonjs/core": "^6.49.0",
    "noa-engine": "^0.33.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prismarine-nbt": "^2.8.0",
    "sharp": "^0.35.4",
    "vite": "^8.2.2"
  }
}
