{
  "name": "world",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "textures": "node scripts/build-textures.mjs",
    "textures:ce": "node scripts/build-textures.mjs --source=ce",
    "textures:vanilla": "node scripts/build-textures.mjs --source=vanilla",
    "sounds": "node scripts/build-sounds.mjs",
    "sounds:free": "node scripts/build-sounds.mjs --source=free",
    "sounds:vanilla": "node scripts/build-sounds.mjs --source=vanilla",
    "postinstall": "node scripts/build-textures.mjs --ensure && node scripts/build-sounds.mjs --ensure",
    "test": "playwright test -c test/playwright.config.js",
    "build:deploy": "rm -rf dist && npm run textures:ce && npm run sounds:free && vite build && cp deploy/_headers deploy/.assetsignore dist/ && node scripts/check-deploy-assets.mjs",
    "deploy": "npm run build:deploy && npx --yes wrangler@4 deploy",
    "deploy:dry-run": "npm run build:deploy && npx --yes wrangler@4 deploy --dry-run"
  },
  "dependencies": {
    "@babylonjs/core": "^6.49.0",
    "noa-engine": "^0.33.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prismarine-nbt": "^2.8.0",
    "sharp": "^0.35.4",
    "vite": "^8.2.2"
  }
}
